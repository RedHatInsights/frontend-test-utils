{
  "name": "@redhat-cloud-services/hcc-page-objects",
  "version": "0.0.0",
  "description": "Reusable page objects for Red Hat Hybrid Cloud Console Playwright e2e testing",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",

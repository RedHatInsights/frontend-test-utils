{
  "name": "hcc-page-objects",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/hcc-page-objects/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/hcc-page-objects",
        "main": "packages/hcc-page-objects/src/index.ts",
        "tsConfig": "packages/hcc-page-objects/tsconfig.lib.json",
        "assets": ["packages/hcc-page-objects/*.md"]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npm publish",
        "cwd": "dist/packages/hcc-page-objects"
      }
    }
  }
}
